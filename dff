_MaxSizeF="15" #Characters - Max_Size_Fild
_Slice="1500000" #Bytes - initial and final slice of the file for hash calculation
_Version="0.2"

##-----Functions---------------------------------##
func_help(){
        echo -e "\n\t\t\tDuplicate File Finder - version: $_Version "
        echo -e "\t\t\t    https://github.com/w6w/dff \n "
        echo -e "\t$0 usage: \n"
        echo -e "\t-h|--help\t:Show help"
        echo -e ""
        echo -e "\t$0  [parameters]  [target_folder] \n"
        echo -e "\t[parameters] may be\t:[-n|-i|-s|-H|-l|-L]"
        echo -e "\t[target_folder] may be\t:[\"absolute\" | \"relative\"] (assumes current \"./\" if omitted)\n"
        echo -e "\t-n|--name\t:Finds files by name (with identical names)"
        echo -e "\t-i|--iname\t:Finds files by name (case INsensitive)"
        echo -e "\t-s|--size\t:Finds files by size (with identical sizes)"
        echo -e "\t-H|--hash\t:Calculates a \"fast hash\" of files of exact sizes in target folder"
	echo -e "\t-l|--lower\t:Lower limit for scan file size (in Bytes)"
	echo -e "\t-L|-U|--upper\t:Upper limit for scan file size (in Bytes)"
        echo -e ""
        echo -e "EXAMPLES:"
        echo -e "$0 --name ./ \t\t#To find files by identical names in current work directory."
        echo -e "$0 --iname -s /etc\t#To find files by names and by size in \"/etc\" directory."
	echo -e "$0 -H -l 10 -L 5000\t#To find files with identical, repeated sizes between 10 and 5000 bytes in current directory."
        echo ""
	exit 0
}

func_info(){
	for i in $(eval echo "{$(( $_NPar - 1 ))..0}") ; do
		case "${_Parametros[$i]}" in
			-n|--name|--Name) _Name="Case_Sensitive" ;;
			-i|--iname) _Name="Case_INsensitive" ;;
			-s|--size) _Size="yes" ;;
			-H|--hash|--md5) _FastHash="yes" ;;
			-h|--help) echo Help ;;
			-l|--lower|--lowerlimit) [[ "${_Parametros[$(($i+1))]}" -gt "0" ]] && _LowerLimFSize="${_Parametros[$(($i+1))]}" ;;
			-U|-L|--upper|--upperlimit) [[ "${_Parametros[$(($i+1))]}" -gt "0" ]] && _UpperLimFSize="${_Parametros[$(($i+1))]}" ;;
			[eE]xit) exit 0 ;;
			*) [[ -d "${_Parametros[$i]}"  ]] && _Dest="${_Parametros[$i]}" ;;
		esac
	done
	echo -e "\nPWD=\"$(pwd)\"\nTarget=\"$_Dest\"\nCompare_names=\"$_Name\"\nCompare_size=\"$_Size\"\nCompare_FastHash=\"$_FastHash\"\nLower_limit_file_size=\"$_LowerLimFSize\"\nUpper_limit_file_size=\"$_UpperLimFSize\"  " 
	[[ -n "$_UpperLimFSize" && "$_UpperLimFSize" -le "$_LowerLimFSize" ]] && { echo -e "\nERROR: The value of \"Upper_limit_file_siz\" cannot be less or equal than \"Lower_limit_file_siz\"\n " ; exit 1 ; }
	_LowerLimFSize="-size +"$_LowerLimFSize"c" ; [[ -n "$_UpperLimFSize" ]] && _UpperLimFSize="-size -"$_UpperLimFSize"c"
}

func_name(){
	_NList="" ; echo ""
	if [[ "$_Name" = "Case_INsensitive" ]] ; then
		echo -e "By name $_Name:\nSize(B):\tFile_name:"
		_NList=$(find -P "$_Dest" -type f $_LowerLimFSize $_UpperLimFSize | awk -F'/' '{nome_orig=$NF; nome_low=tolower(nome_orig); count[nome_low]++; linhas[nome_low]=linhas[nome_low] $0 "\n"} END {for (n in count) if (count[n] > 1) printf "%s", linhas[n]}'  )  
		echo "$_NList" | xargs -d '\n' du -b 2>/dev/null | expand -t "$_MaxSizeF"
		echo ""
	fi
	if [[ "$_Name" = "Case_Sensitive" ]] ; then
		echo -e "By name $_Name:\nSize(B):\tFile_name:"
		_NList=$(find -P "$_Dest" -type f $_LowerLimFSize $_UpperLimFSize | awk -F'/' '{nome=$NF; count[nome]++; linhas[nome]=linhas[nome] $0 "\n"} END {for (n in count) if (count[n] > 1) printf "%s", linhas[n]}' ) 
		echo "$_NList" | xargs -d '\n' du -b 2>/dev/null | expand -t "$_MaxSizeF"
		echo ""
	fi
}

func_size(){
	echo -e "By size (Bytes):\nSize(B):\tFila_name:"
	_SList=$(find "$_Dest" -type f $_LowerLimFSize $_UpperLimFSize -printf "%"$_MaxSizeF"s\t%p\n" | sort -n | uniq -D --check-chars="$_MaxSizeF" | cut -c"$(($_MaxSizeF+2))"- ) 
	echo "$_SList" | xargs -d '\n' du -b 2>/dev/null | expand -t "$_MaxSizeF"
	echo ""
}

func_FastHash(){
	[[ "$_Size" != "yes" ]] && { _Size="yes" ; func_size ; }
	_OutHash="" 
	_OutHash=$(
	_Fa="0" ; _Fu="0"
	if [[ "$_FastHash" = "yes" ]] ; then
		echo -e "Searching for similarities in $(echo "$_SList" | wc -l) files.....\n" >&2
		_Progress="1"
		while read i ; do
			if [[ "`du -b "$i" 2>/dev/null | tr "\t" " " | cut -d" " -f1`" -le "$(($_Slice * 2))" ]] ; then
				echo "00000000000000000000000000000000`md5sum "$i" | cut -d" " -f1` $i" >&3
				_Fu="$(($_Fu+1))"  #Debug
			else
				echo "$(head -c $_Slice "$i" | md5sum | cut -d" " -f1)$(tail -c $(($_Slice+1)) "$i" | md5sum | cut -d" " -f1) $i" >&3
				_Fa="$(($_Fa+1))" #Debug
			fi
			echo -ne "File number\t$_Progress (Fast-md5 = $_Fa , Full-md5 = $_Fu) done; \r" >&2
			_Progress="$(($_Progress+1))"
		done <<< "$_SList" 3>&1 | sort -n | uniq -D --check-chars="64"  #| cut -c"$((64+2))"- 
		#echo "$_SList" | xargs -d '\n' du -b  #Debug
	fi
	)
	[[ -n "$_OutHash" ]] && echo -e "\nSimilar hashes were found in these $(echo "$_OutHash" | wc -l) files! (At the beginning and end of each).\nIt is recommended that you verify whether they are identical before deleting them.\n\n$_OutHash"
}
##-End functions---------------------------------##

#### Main----------------------------------------##
_Parametros=("$@")
_NPar="$#" ; [[ "$_NPar" -eq "0" ]] && func_help
_Dest="./"
_Name="no"
_Size="no"
_FastHash="no"
_LowerLimFSize="0"
_UpperLimFSize="" #Default is empty
func_info
func_name
[[ "$_Size" = "yes" ]] && func_size
[[ "$_FastHash" = "yes" ]] && time func_FastHash
exit 0
#### End Main------------------------------------##